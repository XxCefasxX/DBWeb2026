@{
    ViewData["Title"] = "Otro";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white py-4">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <p class="lead mb-4">Página adicional para demostración de capacidades de la aplicación.</p>
                    
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Esta página muestra cómo podemos crear diferentes vistas con estilos consistentes.
                    </div>
                    
                    <div class="row g-4 mt-4">
                        <div class="col-md-6">
                            <div class="card h-100 border-0">
                                <div class="card-body p-4">
                                    <i class="bi bi-bar-chart-line fs-1 text-warning mb-3 d-block"></i>
                                    <h5 class="card-title">Análisis de Datos</h5>
                                    <p class="card-text">Herramientas para visualizar y analizar información de manera efectiva.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 border-0">
                                <div class="card-body p-4">
                                    <i class="bi bi-gear fs-1 text-secondary mb-3 d-block"></i>
                                    <h5 class="card-title">Configuración Avanzada</h5>
                                    <p class="card-text">Opciones personalizables para adaptar la aplicación a sus necesidades específicas.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <a href="~/Home/Index" class="btn btn-outline-primary me-2">Volver al Inicio</a>
                        <a href="~/Home/Test" class="btn btn-outline-success">Ir a Página de Prueba</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

