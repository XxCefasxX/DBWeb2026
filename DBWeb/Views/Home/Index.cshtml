@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <div class="container">
        <h1 class="display-4 fw-bold mb-4">Bienvenido a DBWeb</h1>
        <p class="lead mb-5">Una aplicación web moderna para gestión de bases de datos</p>
        
        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-display fs-1 text-primary mb-3"></i>
                        <h5 class="card-title">Interfaz Intuitiva</h5>
                        <p class="card-text">Diseño limpio y fácil de usar para todos los usuarios.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-speedometer2 fs-1 text-success mb-3"></i>
                        <h5 class="card-title">Rendimiento Óptimo</h5>
                        <p class="card-text">Consultas rápidas y eficientes para sus datos.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-lock fs-1 text-danger mb-3"></i>
                        <h5 class="card-title">Seguridad Garantizada</h5>
                        <p class="card-text">Protección avanzada para sus datos sensibles.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-5">
            <a href="#" class="btn btn-primary btn-lg px-5 py-3">Explorar Características</a>
        </div>
    </div>
</div>