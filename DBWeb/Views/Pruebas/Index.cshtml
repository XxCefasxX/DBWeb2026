@{
    ViewData["Title"] = "Formulario POS";
    var categorias = ViewData["Categorias"] as List<Categoria> ?? new List<Categoria>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-4">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @ViewData["Mensaje"]
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @ViewData["Error"]
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    <form method="post" asp-controller="Pruebas" asp-action="Enviar">
                        <div class="mb-4">
                            <label for="nombre" class="form-label fw-bold">Nombre del Producto:</label>
                            <input type="text" class="form-control" id="nombre" name="nombre" required>
                        </div>
                        <div>
                            <label>Categoría:</label>
                            <select name="categoriaId">
                                <option value="">-- Seleccione una categoría --</option>
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria.IDCategoria">@categoria.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="cantidad" class="form-label fw-bold">Cantidad:</label>
                            <input type="number" class="form-control" id="cantidad" name="cantidad" min="1" required>
                        </div>
                        
                        <div class="mb-4">
                            <label for="precio" class="form-label fw-bold">Precio Unitario:</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="precio" name="precio" step="0.01" min="0" required>
                            </div>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg py-3">Calcular Total</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>