
@{
    ViewData["Title"] = "Lista de Productos";
    var productos = ViewData["Productos"] as List<Producto> ?? new List<Producto>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-4">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body p-4">
                    @if (productos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Precio</th>
                                        <th>Categoría</th>
                                        <th>Descripción</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var producto in productos)
                                    {
                                        <tr>
                                            <td>@producto.Nombre</td>
                                            <td>$@producto.Precio.ToString("0.00")</td>
                                            <td>@producto.Categoria</td>
                                            <td>@producto.Descripcion</td>
                                            <td class="text-end">
                                                <a href="#" class="btn btn-sm btn-outline-primary me-2">Ver</a>
                                                <a href="#" class="btn btn-sm btn-outline-success">Editar</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center py-4">
                            <i class="bi bi-info-circle fs-1 mb-3 d-block"></i>
                            <p class="mb-0">No hay productos disponibles actualmente.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
